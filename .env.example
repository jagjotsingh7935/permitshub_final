# Copy to .env on the server (cp .env.example .env) and fill in every value.

# Public domain Caddy serves and gets an HTTPS certificate for.
DOMAIN=permitshub.com.au

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=permitshub.com.au,www.permitshub.com.au
DJANGO_CSRF_TRUSTED_ORIGINS=https://permitshub.com.au,https://www.permitshub.com.au

# Database
POSTGRES_DB=permitshub
POSTGRES_USER=permitshub
POSTGRES_PASSWORD=change-me

# First admin login (created on first start if it does not exist yet)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-too
DJANGO_SUPERUSER_EMAIL=permits@permitshub.com.au

# Email. Enquiry confirmations are sent FROM permits@permitshub.com.au.
# The domain's MX record points to Google, so use a Google Workspace / Gmail
# app password (Google Account > Security > 2-Step Verification > App passwords).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=permits@permitshub.com.au
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Permits Hub <permits@permitshub.com.au>
